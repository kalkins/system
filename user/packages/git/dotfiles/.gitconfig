[core]
    pager = delta
[user]
	email = sindre@sindrestephansen.com
	name = Sindre Stephansen
    signingkey = B06FC67D17A46ADE
[web]
	browser = firefox
[alias]
	lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
	co = checkout
	new = checkout -b
	mg = merge --no-ff --no-edit
	oops = commit --amend --no-edit
	oneline = log --pretty=oneline --abbrev-commit
	unstage = reset HEAD --
	get = "!sh -c \"git checkout --track origin/$1\" -"
[color]
	ui = auto
[core]
	autocrlf = input
[core]
	pager = less

[includeIf "gitdir:~/workspace/kodeworks/"]
   path = ~/.git-kodeworks.conf
[push]
	default = current
	autoSetupRemote = yes
[pull]
	ff = only
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
[commit]
    gpgsign = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[rerere]
	enabled = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
[diff]
    algorithm = histogram

